{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "有声书工坊",
  "version": "0.1.0",
  "identifier": "studio.audiobook.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "有声书工坊",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [],
    "category": "AudioVideo",
    "shortDescription": "有声书读音统一与审听",
    "longDescription": "词典版本管理、同形词例外、波形审听批注、离线打包与差异报告"
  }
}